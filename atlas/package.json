{
  "name": "@nanohype/atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-model.ts",
    "emit": "node scripts/emit.ts ../profile/assets/atlas",
    "fallbacks": "node scripts/fallbacks.ts",
    "shots": "node scripts/shoot.ts shots"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "description": "Architecture diagrams for the nanohype stack, and the generator that produces them.",
  "license": "Apache-2.0"
}
